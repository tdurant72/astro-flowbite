---
import "@fontsource-variable/inter";
import "../styles/global.css";
import data from "../data/site.json";
import { Hammer, Mail, Phone, Calendar, ArrowRight, Github, Linkedin, Twitter } from "lucide-react";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Under Construction | {data.siteName}</title>
    <meta name="description" content={`We are currently upgrading ${data.siteName}. We will be back shortly with a brand new digital experience.`} />
    <script is:inline>
      if (
        localStorage.getItem("theme") === "dark" ||
        (!("theme" in localStorage) &&
          window.matchMedia("(prefers-color-scheme: dark)").matches)
      ) {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }
    </script>
  </head>
  <body class="bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 font-sans selection:bg-brand-teal/20 selection:text-teal-900 min-h-screen flex flex-col justify-between relative overflow-hidden">
    
    <!-- Background Decorative Gradients -->
    <div class="absolute -top-40 -right-40 w-96 h-96 bg-brand-teal/20 dark:bg-brand-teal/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-teal-500/20 dark:bg-teal-500/5 rounded-full blur-3xl pointer-events-none"></div>

    <!-- Top Bar / Brand Header -->
    <header class="w-full max-w-6xl mx-auto px-6 py-8 flex justify-between items-center z-10">
      <div class="flex items-center gap-2">
        <span class="text-xl font-black tracking-tight bg-linear-to-r from-teal-500 to-emerald-400 bg-clip-text text-transparent">
          {data.siteName}
        </span>
      </div>
      
      <!-- Theme Toggle Switch -->
      <button 
        id="theme-toggle" 
        class="p-2.5 rounded-xl border border-slate-200 dark:border-slate-800/80 hover:bg-slate-50 dark:hover:bg-slate-900 transition-colors duration-200 focus:outline-hidden"
        aria-label="Toggle theme"
      >
        <span class="dark:hidden text-slate-600 text-sm font-semibold">Dark Mode</span>
        <span class="hidden dark:inline text-slate-400 text-sm font-semibold">Light Mode</span>
      </button>
    </header>

    <!-- Main Content Area -->
    <main class="flex-1 flex flex-col items-center justify-center px-6 py-12 z-10 w-full max-w-3xl mx-auto">
      <div class="w-full text-center space-y-8">
        
        <!-- Status Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-teal-500/10 border border-teal-500/20 text-brand-teal dark:text-teal-400 text-xs font-semibold uppercase tracking-wider animate-pulse">
          <Hammer className="w-3.5 h-3.5" />
          Upgrading System
        </div>

        <!-- Hero Headline -->
        <div class="space-y-4">
          <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight leading-tight">
            Implementing <span class="bg-linear-to-r from-teal-500 via-emerald-400 to-teal-600 bg-clip-text text-transparent">V2V Framework</span>
          </h1>
          <p class="text-base sm:text-lg text-slate-600 dark:text-slate-400 max-w-lg mx-auto leading-relaxed">
            We're temporarily offline deploying version 2.0 of our visibility architecture. Expect significantly faster engine response and enhanced search visibility.
          </p>
        </div>

        <!-- Glassmorphism Card for Status Updates / Contact -->
        <div class="glass p-6 sm:p-8 rounded-2xl max-w-xl mx-auto text-left space-y-6 shadow-xl shadow-slate-100/50 dark:shadow-none">
          <h3 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-teal-500"></span> Need to get in touch?
          </h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Our consulting, project briefings, and audit requests are active in the background. Contact Tyus Durant directly:
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <a 
              href={`mailto:${data.contact.email}`} 
              class="flex items-center gap-3 p-3.5 rounded-xl border border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/35 hover:bg-slate-100 dark:hover:bg-slate-800/50 hover:border-teal-500/30 transition-all duration-300 group"
            >
              <div class="p-2 rounded-lg bg-teal-500/10 text-brand-teal">
                <Mail className="w-4 h-4" />
              </div>
              <div class="truncate">
                <div class="text-[11px] text-slate-400 uppercase font-semibold">Email</div>
                <div class="text-xs font-semibold text-slate-800 dark:text-slate-200 group-hover:text-brand-teal transition-colors truncate">{data.contact.email}</div>
              </div>
            </a>

            <a 
              href={`tel:${data.contact.phone.replace(/[^0-9]/g, '')}`} 
              class="flex items-center gap-3 p-3.5 rounded-xl border border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/35 hover:bg-slate-100 dark:hover:bg-slate-800/50 hover:border-teal-500/30 transition-all duration-300 group"
            >
              <div class="p-2 rounded-lg bg-teal-500/10 text-brand-teal">
                <Phone className="w-4 h-4" />
              </div>
              <div>
                <div class="text-[11px] text-slate-400 uppercase font-semibold">Phone</div>
                <div class="text-xs font-semibold text-slate-800 dark:text-slate-200 group-hover:text-brand-teal transition-colors">{data.contact.phone}</div>
              </div>
            </a>
          </div>
        </div>

      </div>
    </main>

    <!-- Footer Area / Socials -->
    <footer class="w-full max-w-6xl mx-auto px-6 py-8 border-t border-slate-100 dark:border-slate-900 flex flex-col sm:flex-row justify-between items-center gap-4 z-10">
      <p class="text-xs text-slate-400 dark:text-slate-500">
        &copy; {new Date().getFullYear()} {data.owner}. All rights reserved.
      </p>
      
      <!-- Social Links -->
      <div class="flex items-center gap-4">
        {data.social.map(s => {
          let Icon = Github;
          if (s.title.toLowerCase() === 'twitter') Icon = Twitter;
          else if (s.title.toLowerCase() === 'linkedin') Icon = Linkedin;
          
          return (
            <a 
              href={s.href} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="p-2 rounded-lg text-slate-400 hover:text-brand-teal hover:bg-slate-100 dark:hover:bg-slate-900 transition-all duration-200"
              title={s.title}
            >
              <Icon className="w-4 h-4" />
            </a>
          );
        })}
      </div>
    </footer>

    <!-- Simple Script to Handle Theme Toggle -->
    <script>
      const btn = document.getElementById("theme-toggle");
      if (btn) {
        btn.addEventListener("click", () => {
          const isDark = document.documentElement.classList.contains("dark");
          if (isDark) {
            document.documentElement.classList.remove("dark");
            localStorage.setItem("theme", "light");
          } else {
            document.documentElement.classList.add("dark");
            localStorage.setItem("theme", "dark");
          }
        });
      }
    </script>
  </body>
</html>
